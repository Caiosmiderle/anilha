# Production (Vercel > Project > Settings > Environment Variables).
# Supabase > Project Settings > API: Project URL.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Supabase > Project Settings > API Keys: publishable key (sb_publishable_...) or legacy anon key.
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# Web push for reminders (optional). Public key from `npx web-push generate-vapid-keys`.
VITE_VAPID_PUBLIC_KEY=
# Never set this in production: it only shows the login code from the local dev server.
VITE_SHOW_DEV_CODE=
